# Copy thành .env (cùng thư mục) rồi điền. .env không được commit.

# Home Assistant: hồ sơ người dùng (góc dưới trái) > Security > Long-lived access tokens > Create token
HA_URL=http://localhost:8123
HA_TOKEN=

# LLM qua API tương thích OpenAI. Model phải hỗ trợ tool calling. Ví dụ:
#   Gemini:     OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/   LLM_MODEL=gemini-2.5-flash
#   Groq:       OPENAI_BASE_URL=https://api.groq.com/openai/v1                           LLM_MODEL=llama-3.3-70b-versatile
#   OpenRouter: OPENAI_BASE_URL=https://openrouter.ai/api/v1                             LLM_MODEL=<tên model trên OpenRouter>
#   OpenAI:     OPENAI_BASE_URL= (để trống)                                               LLM_MODEL=<tên model OpenAI>
#   Ollama:     OPENAI_BASE_URL=http://localhost:11434/v1  OPENAI_API_KEY=ollama          LLM_MODEL=qwen2.5:7b
OPENAI_BASE_URL=
OPENAI_API_KEY=
LLM_MODEL=

# Discord: Developer Portal > Application > Bot > Reset Token. Bật "Message Content Intent".
DISCORD_BOT_TOKEN=
# Tuỳ chọn: ID kênh mà bot trả lời mọi tin (không cần @bot). Để trống thì chỉ trả lời khi được @ hoặc nhắn riêng.
DISCORD_CHANNEL_ID=

# MCP server qua HTTP (Docker, Tailscale) bắt buộc token Bearer, ít nhất 16 ký tự.
# Tạo: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_AUTH_TOKEN=
